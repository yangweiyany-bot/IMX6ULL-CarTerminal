[Unit]
Description=IMX6ULL Car Terminal monitor
Documentation=file://@CMAKE_INSTALL_FULL_DATAROOTDIR@/doc/imx6ull-car-terminal/README.md
After=local-fs.target network.target

[Service]
Type=simple
User=car-terminal
Group=car-terminal
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/car_terminal --config @CAR_TERMINAL_INSTALL_CONFIG_ABSOLUTE_DIR@/systemd.conf
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
StateDirectory=imx6ull-car-terminal
StateDirectoryMode=0750
LogsDirectory=imx6ull-car-terminal
LogsDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_CAN

[Install]
WantedBy=multi-user.target
